<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- base_footprint: virtual link at ground level -->
  <link name="base_footprint"/>

  <!-- base_link: physical chassis center, lifted by wheel radius -->
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.075" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry>
        <!-- 600mm x 400mm x 100mm aluminum frame chassis -->
        <box size="0.60 0.40 0.10"/>
      </geometry>
      <material name="silver">
        <color rgba="0.75 0.75 0.75 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.60 0.40 0.10"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <!-- box inertia: m/12*(h^2+d^2), etc. -->
      <inertia ixx="0.0558" ixy="0" ixz="0"
               iyy="0.1083" iyz="0"
               izz="0.1417"/>
    </inertial>
  </link>

</robot>
