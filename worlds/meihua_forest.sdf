    <!-- ===== R1 Robot — left start/retry zone (-5.54, 5.54), yaw=0 faces into field ===== -->
    <model name="r1_robot">
      <pose>-5.54 5.54 0.075 0 0 0</pose>

      <!-- Chassis (pink — team 1) -->
      <link name="base_link">
        <visual name="chassis_visual">
          <geometry>
            <box><size>0.60 0.40 0.10</size></box>
          </geometry>
          <material>
            <ambient>0.90 0.45 0.55 1</ambient>
            <diffuse>0.90 0.45 0.55 1</diffuse>
          </material>
        </visual>
        <collision name="chassis_collision">
          <geometry>
            <box><size>0.60 0.40 0.10</size></box>
          </geometry>
        </collision>
        <inertial>
          <mass>5.0</mass>
          <inertia>
            <ixx>0.0558</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.1083</iyy><iyz>0</iyz><izz>0.1417</izz>
          </inertia>
        </inertial>
      </link>

      <!-- Rear left driven wheel -->
      <link name="wheel_rear_left_link">
        <pose relative_to="base_link">-0.20 0.225 0 0 0 0</pose>
        <visual name="visual">
          <pose>0 0 0 1.5708 0 0</pose>
          <geometry>
            <cylinder><radius>0.075</radius><length>0.05</length></cylinder>
          </geometry>
          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <pose>0 0 0 1.5708 0 0</pose>
          <geometry>
            <cylinder><radius>0.075</radius><length>0.05</length></cylinder>
          </geometry>
        </collision>
        <inertial>
          <mass>0.5</mass>
          <inertia>
            <ixx>0.0014</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.0014</iyy><iyz>0</iyz><izz>0.0014</izz>
          </inertia>
        </inertial>
      </link>
      <joint name="wheel_rear_left_joint" type="revolute">
        <parent>base_link</parent>
        <child>wheel_rear_left_link</child>
        <axis>
          <xyz expressed_in="__model__">0 1 0</xyz>
          <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        </axis>
      </joint>

      <!-- Rear right driven wheel -->
      <link name="wheel_rear_right_link">
        <pose relative_to="base_link">-0.20 -0.225 0 0 0 0</pose>
        <visual name="visual">
          <pose>0 0 0 1.5708 0 0</pose>
          <geometry>
            <cylinder><radius>0.075</radius><length>0.05</length></cylinder>
          </geometry>
          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <pose>0 0 0 1.5708 0 0</pose>
          <geometry>
            <cylinder><radius>0.075</radius><length>0.05</length></cylinder>
          </geometry>
        </collision>
        <inertial>
          <mass>0.5</mass>
          <inertia>
            <ixx>0.0014</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.0014</iyy><iyz>0</iyz><izz>0.0014</izz>
          </inertia>
        </inertial>
      </link>
      <joint name="wheel_rear_right_joint" type="revolute">
        <parent>base_link</parent>
        <child>wheel_rear_right_link</child>
        <axis>
          <xyz expressed_in="__model__">0 1 0</xyz>
          <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        </axis>
      </joint>

      <!-- Front left caster -->
      <link name="caster_front_left_link">
        <pose relative_to="base_link">0.22 0.15 -0.035 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <sphere><radius>0.04</radius></sphere>
          </geometry>
          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <sphere><radius>0.04</radius></sphere>
          </geometry>
          <surface>
            <friction>
              <ode><mu>0.01</mu><mu2>0.01</mu2></ode>
            </friction>
          </surface>
        </collision>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.00006</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.00006</iyy><iyz>0</iyz><izz>0.00006</izz>
          </inertia>
        </inertial>
      </link>
      <joint name="caster_front_left_joint" type="fixed">
        <parent>base_link</parent>
        <child>caster_front_left_link</child>
      </joint>

      <!-- Front right caster -->
      <link name="caster_front_right_link">
        <pose relative_to="base_link">0.22 -0.15 -0.035 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <sphere><radius>0.04</radius></sphere>
          </geometry>
          <material>
            <ambient>0.15 0.15 0.15 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <sphere><radius>0.04</radius></sphere>
          </geometry>
          <surface>
            <friction>
              <ode><mu>0.01</mu><mu2>0.01</mu2></ode>
            </friction>
          </surface>
        </collision>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.00006</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.00006</iyy><iyz>0</iyz><izz>0.00006</izz>
          </inertia>
        </inertial>
      </link>
      <joint name="caster_front_right_joint" type="fixed">
        <parent>base_link</parent>
        <child>caster_front_right_link</child>
      </joint>

      <!-- Gazebo plugins -->
      <plugin filename="gz-sim-diff-drive-system"
              name="gz::sim::systems::DiffDrive">
        <left_joint>wheel_rear_left_joint</left_joint>
        <right_joint>wheel_rear_right_joint</right_joint>
        <wheel_separation>0.45</wheel_separation>
        <wheel_radius>0.075</wheel_radius>
        <odom_publish_frequency>50</odom_publish_frequency>
        <topic>/r1/cmd_vel</topic>
        <odom_topic>/r1/odom</odom_topic>
        <tf_topic>/r1/tf</tf_topic>
        <frame_id>r1_odom</frame_id>
        <child_frame_id>r1_base_footprint</child_frame_id>
      </plugin>
    </model>

    <!-- ===== R2 Robot — spawned from URDF via ros_gz_sim create ===== -->
    <!-- R2 model is now spawned dynamically from the URDF xacro in auto.launch.py -->

  </world>
</sdf>