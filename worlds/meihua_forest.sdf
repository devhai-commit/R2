            <ambient>0.76 0.87 0.93 1</ambient>
            <diffuse>0.76 0.87 0.93 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- R1 Retry Zone — Left top corner (dark red, 1000×1000mm) -->
    <model name="z1_retry_r1_left">
      <static>true</static>
      <pose>-5.54 5.54 0.003 0 0 0</pose>
      <link name="link">
        <visual name="visual">
