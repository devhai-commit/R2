    <!-- =====================================================
         Zone 3 slope + platform — per cross-section diagram
         Slope : y = -3.39 → -4.89  (1500 mm run)
                 z =  0.00 →  0.45  (450 mm rise)
                 angle = atan(0.45/1.5) ≈ 16.7° ≈ 15°
                 hypotenuse = sqrt(1.5²+0.45²) = 1.566 m
                 roll = -atan(0.45/1.5) = -0.2915 rad
                 box centre (world) : y=-4.14, z=0.225
         Platform: y = -4.89 → -6.09  (1200 mm depth)
                   z = 0 → 0.45 m (solid 450 mm slab)
                   box centre: y=-5.49, z=0.225
    ===================================================== -->

    <!-- Zone 3 Slope — tilted box, full field width (12.18 m) -->
    <model name="z3_slope">
      <static>true</static>
      <!-- roll=-0.2915 rad tilts -Y end up to z=0.45, +Y end down to z=0 -->
      <pose>0 -4.14 0.225 -0.2915 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>12.18 1.566 0.10</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>12.18 1.566 0.10</size>
            </box>
          </geometry>
          <material>
            <ambient>0.65 0.65 0.65 1</ambient>
            <diffuse>0.65 0.65 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

