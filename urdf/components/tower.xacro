<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Main tower column (aluminum extrusion frame) -->
  <link name="tower_link">
    <visual>
      <geometry>
        <box size="0.10 0.15 0.90"/>
      </geometry>
      <!-- origin at tower bottom, visual centered at mid-height -->
      <origin xyz="0 0 0.45" rpy="0 0 0"/>
      <material name="silver">
        <color rgba="0.75 0.75 0.75 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.10 0.15 0.90"/>
      </geometry>
      <origin xyz="0 0 0.45" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="1.5"/>
      <inertia ixx="0.1016" ixy="0" ixz="0"
               iyy="0.1016" iyz="0"
               izz="0.0028"/>
    </inertial>
  </link>

  <joint name="tower_joint" type="fixed">
    <parent link="base_link"/>
    <child link="tower_link"/>
    <!-- mounted near rear-center of chassis, on top surface -->
    <origin xyz="-0.15 0 0.05" rpy="0 0 0"/>
  </joint>

  <!-- Blue belt pulley — left side -->
  <link name="pulley_left_link">
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.025"/>
      </geometry>
      <material name="blue">
        <color rgba="0.1 0.3 0.85 1"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00003" ixy="0" ixz="0"
               iyy="0.00003" iyz="0"
               izz="0.00004"/>
    </inertial>
  </link>

  <joint name="pulley_left_joint" type="fixed">
    <parent link="tower_link"/>
    <child link="pulley_left_link"/>
    <origin xyz="-0.07 0 0.65" rpy="${pi/2} 0 0"/>
  </joint>

  <!-- Blue belt pulley — right side -->
  <link name="pulley_right_link">
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.025"/>
      </geometry>
      <material name="blue">
        <color rgba="0.1 0.3 0.85 1"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00003" ixy="0" ixz="0"
               iyy="0.00003" iyz="0"
               izz="0.00004"/>
    </inertial>
  </link>

  <joint name="pulley_right_joint" type="fixed">
    <parent link="tower_link"/>
    <child link="pulley_right_link"/>
    <origin xyz="0.07 0 0.65" rpy="${pi/2} 0 0"/>
  </joint>

</robot>
