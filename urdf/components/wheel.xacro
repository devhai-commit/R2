<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Driven wheel macro (continuous joint, rotates around Y axis) -->
  <xacro:macro name="wheel" params="name parent x y z">
    <link name="${name}_link">
      <visual>
        <geometry>
          <cylinder radius="0.075" length="0.05"/>
        </geometry>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <material name="dark_grey">
          <color rgba="0.15 0.15 0.15 1"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="0.075" length="0.05"/>
        </geometry>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      </collision>
      <inertial>
        <mass value="0.5"/>
        <inertia ixx="0.0014" ixy="0" ixz="0"
                 iyy="0.0014" iyz="0"
                 izz="0.0014"/>
      </inertial>
    </link>

    <!-- Red hub disc (visual only) -->
    <link name="${name}_hub_link">
      <visual>
        <geometry>
          <cylinder radius="0.045" length="0.012"/>
        </geometry>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <material name="red">
          <color rgba="0.8 0.1 0.1 1"/>
        </material>
      </visual>
      <inertial>
        <mass value="0.01"/>
        <inertia ixx="0.00001" ixy="0" ixz="0"
                 iyy="0.00001" iyz="0"
                 izz="0.00001"/>
      </inertial>
    </link>

    <joint name="${name}_joint" type="continuous">
      <parent link="${parent}"/>
      <child link="${name}_link"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>

    <joint name="${name}_hub_joint" type="fixed">
      <parent link="${name}_link"/>
      <child link="${name}_hub_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <!-- Passive caster macro (fixed joint, small sphere) -->
  <xacro:macro name="caster" params="name parent x y">
    <link name="${name}_link">
      <visual>
        <geometry>
          <sphere radius="0.04"/>
        </geometry>
        <material name="dark_grey">
          <color rgba="0.15 0.15 0.15 1"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <sphere radius="0.04"/>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.01</mu>
              <mu2>0.01</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.00006" ixy="0" ixz="0"
                 iyy="0.00006" iyz="0"
                 izz="0.00006"/>
      </inertial>
    </link>

    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}_link"/>
      <!-- z=-0.035 puts caster bottom at same level as driven wheel bottom -->
      <origin xyz="${x} ${y} -0.035" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

</robot>
