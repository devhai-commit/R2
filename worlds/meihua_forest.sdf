    </model>

    <!-- Staff Rack — Left (brown, 800×300×600mm, between R1 and R2 zones) -->
    <model name="z1_staff_rack_left">
      <static>true</static>
      <pose>-3.44 6.065 0 0 0 0</pose>
      
      <link name="rack_link">

        <!-- Thanh đáy -->
        <collision name="base_col">
          <pose>0 0 0.025 0 0 0</pose>
          <geometry>
            <box>
              <size>0.8 0.05 0.05</size>
            </box>
          </geometry>
        </collision>

        <visual name="base_vis">
          <pose>0 0 0.025 0 0 0</pose>
          <geometry>
            <box>
              <size>0.8 0.05 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.50 0.30 0.12 1</ambient>
            <diffuse>0.50 0.30 0.12 1</diffuse>
          </material>
        </visual>

        <!-- Trụ trái -->
        <collision name="left_col">
          <pose>-0.35 0 0.30 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 0.05 0.6</size>
            </box>
          </geometry>
        </collision>

        <visual name="left_vis">
          <pose>-0.35 0 0.30 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 0.05 0.6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.50 0.30 0.12 1</ambient>
            <diffuse>0.50 0.30 0.12 1</diffuse>
          </material>
        </visual>

        <!-- Trụ phải -->
        <collision name="right_col">
          <pose>0.35 0 0.30 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 0.05 0.6</size>
            </box>
          </geometry>
        </collision>

        <visual name="right_vis">
          <pose>0.35 0 0.30 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 0.05 0.6</size>
            </box>
          </geometry>
          <material>
            <ambient>0.50 0.30 0.12 1</ambient>
            <diffuse>0.50 0.30 0.12 1</diffuse>
          </material>
        </visual>

        <!-- Thanh ngang trên -->
        <collision name="top_col">
          <pose>0 0 0.575 0 0 0</pose>
          <geometry>
            <box>
              <size>0.7 0.05 0.05</size>
            </box>
